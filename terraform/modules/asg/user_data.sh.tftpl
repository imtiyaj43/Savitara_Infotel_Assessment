#!/bin/bash
set -euo pipefail

echo "=========================================================="
echo "Starting Savitara Infotel Application EC2 Initialization"
echo "Timestamp: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
echo "=========================================================="

# 1. Update OS and install runtime packages
echo "[STEP 1] Installing Node.js, npm, jq, and required packages..."
dnf clean all
dnf makecache
dnf install -y nodejs npm jq awscli

# 2. Create application system user
echo "[STEP 2] Configuring service user..."
id -u appuser &>/dev/null || useradd -r -s /sbin/nologin -d /opt/app appuser

# 3. Create application directory
APP_DIR="/opt/app"
mkdir -p "$${APP_DIR}/src"

# 4. Write package.json
cat << 'EOF' > "$${APP_DIR}/package.json"
{
  "name": "savitara-infotel-app",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  }
}
EOF

# 5. Write src/db.js
cat << 'EOF' > "$${APP_DIR}/src/db.js"
const mysql = require('mysql2/promise');
const { SecretsManagerClient, GetSecretValueCommand } = require('@aws-sdk/client-secrets-manager');

let pool = null;
let cachedCredentials = null;

async function getDbCredentials() {
  if (cachedCredentials) return cachedCredentials;

  if (process.env.DB_HOST && process.env.DB_USER && process.env.DB_PASSWORD) {
    cachedCredentials = {
      host: process.env.DB_HOST,
      user: process.env.DB_USER,
      password: process.env.DB_PASSWORD,
      database: process.env.DB_NAME || 'appdb',
      port: parseInt(process.env.DB_PORT || '3306', 10),
    };
    return cachedCredentials;
  }

  const secretName = process.env.DB_SECRET_NAME;
  const region = process.env.AWS_REGION || 'us-east-1';

  if (secretName) {
    try {
      console.log(`[DB] Fetching credentials from Secrets Manager: $${secretName}`);
      const client = new SecretsManagerClient({ region });
      const command = new GetSecretValueCommand({ SecretId: secretName });
      const response = await client.send(command);
      if (response.SecretString) {
        const secret = JSON.parse(response.SecretString);
        cachedCredentials = {
          host: secret.host || process.env.DB_HOST,
          user: secret.username || secret.user || process.env.DB_USER,
          password: secret.password,
          database: secret.dbname || secret.database || process.env.DB_NAME || 'appdb',
          port: parseInt(secret.port || process.env.DB_PORT || '3306', 10),
        };
        console.log(`[DB] Connected credentials loaded for: $${cachedCredentials.host}`);
        return cachedCredentials;
      }
    } catch (err) {
      console.error(`[DB] Secrets Manager fetch error: $${err.message}`);
    }
  }

  return {
    host: process.env.DB_HOST || '127.0.0.1',
    user: process.env.DB_USER || 'root',
    password: process.env.DB_PASSWORD || 'password',
    database: process.env.DB_NAME || 'appdb',
    port: parseInt(process.env.DB_PORT || '3306', 10),
  };
}

async function getPool() {
  if (!pool) {
    const creds = await getDbCredentials();
    pool = mysql.createPool({
      host: creds.host,
      user: creds.user,
      password: creds.password,
      database: creds.database,
      port: creds.port,
      waitForConnections: true,
      connectionLimit: 10,
      queueLimit: 0,
      connectTimeout: 5000,
      enableKeepAlive: true,
      keepAliveInitialDelay: 10000,
    });
  }
  return pool;
}

async function checkDatabase() {
  try {
    const p = await getPool();
    const startTime = Date.now();
    const [rows] = await p.query('SELECT NOW() AS current_time, VERSION() AS mysql_version, 1 AS healthy');
    return {
      connected: true,
      latency_ms: Date.now() - startTime,
      server_time: rows[0]?.current_time,
      engine_version: rows[0]?.mysql_version,
      database_name: (await getDbCredentials()).database,
    };
  } catch (error) {
    return {
      connected: false,
      error: error.message,
      code: error.code || 'UNKNOWN_ERROR',
    };
  }
}

async function closePool() {
  if (pool) {
    await pool.end();
    pool = null;
  }
}

module.exports = { getDbCredentials, getPool, checkDatabase, closePool };
EOF

# 6. Write src/app.js
cat << 'EOF' > "$${APP_DIR}/src/app.js"
const express = require('express');
const http = require('http');
const { checkDatabase } = require('./db');

const app = express();
app.use(express.json());

app.use((req, res, next) => {
  const start = Date.now();
  res.on('finish', () => {
    console.log(`[HTTP] $${req.method} $${req.originalUrl} $${res.statusCode} $${Date.now() - start}ms`);
  });
  next();
});

let ec2MetadataCache = null;

async function getEc2Metadata() {
  if (ec2MetadataCache) return ec2MetadataCache;

  const fetchWithTimeout = (url, options = {}, timeoutMs = 1500) => {
    return new Promise((resolve, reject) => {
      const u = new URL(url);
      const req = http.request(
        {
          hostname: u.hostname,
          port: u.port || 80,
          path: u.pathname,
          method: options.method || 'GET',
          headers: options.headers || {},
          timeout: timeoutMs,
        },
        (res) => {
          let data = '';
          res.on('data', (c) => (data += c));
          res.on('end', () => resolve({ status: res.statusCode, data }));
        }
      );
      req.on('error', reject);
      req.on('timeout', () => { req.destroy(); reject(new Error('Timeout')); });
      if (options.body) req.write(options.body);
      req.end();
    });
  };

  try {
    const tokenRes = await fetchWithTimeout(
      'http://169.254.169.254/latest/api/token',
      { method: 'PUT', headers: { 'X-aws-ec2-metadata-token-ttl-seconds': '60' } },
      1000
    );
    const token = tokenRes.data;
    const headers = { 'X-aws-ec2-metadata-token': token };

    const [instanceId, az, localIp] = await Promise.all([
      fetchWithTimeout('http://169.254.169.254/latest/meta-data/instance-id', { headers }, 1000),
      fetchWithTimeout('http://169.254.169.254/latest/meta-data/placement/availability-zone', { headers }, 1000),
      fetchWithTimeout('http://169.254.169.254/latest/meta-data/local-ipv4', { headers }, 1000),
    ]);

    ec2MetadataCache = {
      is_ec2: true,
      instance_id: instanceId.data.trim(),
      availability_zone: az.data.trim(),
      private_ip: localIp.data.trim(),
      imds_version: 'IMDSv2',
    };
    return ec2MetadataCache;
  } catch (_e) {
    return {
      is_ec2: false,
      instance_id: 'local-test',
      availability_zone: process.env.AWS_REGION || 'unknown',
      private_ip: '127.0.0.1',
      imds_version: 'Fallback',
    };
  }
}

app.get('/health', (_req, res) => {
  res.status(200).json({
    status: 'healthy',
    service: 'savitara-infotel-api',
    uptime_seconds: Math.floor(process.uptime()),
    timestamp: new Date().toISOString(),
  });
});

app.get('/', async (_req, res) => {
  const metadata = await getEc2Metadata();
  const dbStatus = await checkDatabase();
  res.status(200).json({
    project: 'Savitara Infotel - DevOps Practical Task',
    status: 'OPERATIONAL',
    timestamp: new Date().toISOString(),
    architecture: {
      ingress: 'ALB (HTTPS / TLS 1.3)',
      compute: 'EC2 Auto Scaling Group (Private Subnets)',
      database: 'Amazon RDS MySQL 8.0 (Private Subnets)',
      secrets: 'AWS Secrets Manager',
    },
    runtime: metadata,
    database: dbStatus,
  });
});

app.get('/db-check', async (_req, res) => {
  const dbStatus = await checkDatabase();
  res.status(dbStatus.connected ? 200 : 503).json({
    database_check: dbStatus,
    timestamp: new Date().toISOString(),
  });
});

app.get('/info', async (_req, res) => {
  const metadata = await getEc2Metadata();
  res.status(200).json({
    aws_compute: metadata,
    uptime_seconds: Math.floor(process.uptime()),
  });
});

module.exports = app;
EOF

# 7. Write src/server.js
cat << 'EOF' > "$${APP_DIR}/src/server.js"
const app = require('./app');
const { closePool } = require('./db');

const PORT = parseInt(process.env.PORT || '8080', 10);
const HOST = '0.0.0.0';

const server = app.listen(PORT, HOST, () => {
  console.log(`Savitara Infotel App listening on http://$${HOST}:$${PORT}`);
});

const shutdown = async (signal) => {
  console.log(`Received $${signal}. Closing gracefully...`);
  server.close(async () => {
    try {
      await closePool();
      process.exit(0);
    } catch (_e) {
      process.exit(1);
    }
  });
};

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));
EOF

# 8. Install npm production dependencies
echo "[STEP 3] Installing application dependencies..."
cd "$${APP_DIR}"
npm install --omit=dev

# 9. Query AWS Secrets Manager for DB credentials to create local environment file
echo "[STEP 4] Fetching initial secret metadata from AWS Secrets Manager..."
SECRET_RAW=""
for i in {1..8}; do
  if SECRET_RAW=$(aws secretsmanager get-secret-value --secret-id "${db_secret_name}" --region "${aws_region}" --query SecretString --output text 2>/dev/null); then
    echo "Successfully retrieved DB credentials from Secrets Manager."
    break
  fi
  echo "Retrying Secrets Manager fetch in 5 seconds (attempt $i/8)..."
  sleep 5
done

if [ -n "$${SECRET_RAW}" ]; then
  DB_HOST=$(echo "$${SECRET_RAW}" | jq -r '.host // empty')
  DB_USER=$(echo "$${SECRET_RAW}" | jq -r '.username // empty')
  DB_PASS=$(echo "$${SECRET_RAW}" | jq -r '.password // empty')
  DB_NAME=$(echo "$${SECRET_RAW}" | jq -r '.database // empty')
  DB_PORT=$(echo "$${SECRET_RAW}" | jq -r '.port // "3306"')

  cat << EOF > "$${APP_DIR}/.env"
NODE_ENV=production
PORT=${app_port}
AWS_REGION=${aws_region}
DB_SECRET_NAME=${db_secret_name}
DB_HOST=$${DB_HOST}
DB_USER=$${DB_USER}
DB_PASSWORD=$${DB_PASS}
DB_NAME=$${DB_NAME}
DB_PORT=$${DB_PORT}
APP_STORAGE_BUCKET=${app_storage_bucket}
EOF
else
  cat << EOF > "$${APP_DIR}/.env"
NODE_ENV=production
PORT=${app_port}
AWS_REGION=${aws_region}
DB_SECRET_NAME=${db_secret_name}
APP_STORAGE_BUCKET=${app_storage_bucket}
EOF
fi

# Secure .env permissions
chmod 600 "$${APP_DIR}/.env"
chown -R appuser:appuser "$${APP_DIR}"

# 10. Create systemd service unit
echo "[STEP 5] Configuring systemd service..."
cat << 'EOF' > /etc/systemd/system/savitara-app.service
[Unit]
Description=Savitara Infotel Backend Node.js Application
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/app
EnvironmentFile=/opt/app/.env
ExecStart=/usr/bin/node /opt/app/src/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=savitara-app

[Install]
WantedBy=multi-user.target
EOF

# 11. Enable and start application service
systemctl daemon-reload
systemctl enable savitara-app.service
systemctl restart savitara-app.service

# 12. Local Health Verification Loop
echo "[STEP 6] Verifying local health endpoint..."
for i in {1..10}; do
  if curl -sf "http://127.0.0.1:${app_port}/health" >/dev/null; then
    echo "Savitara application health check PASSED on attempt $i."
    exit 0
  fi
  echo "Waiting for app to start (attempt $i/10)..."
  sleep 3
done

echo "Warning: Application did not respond within 30 seconds. Check systemctl status savitara-app."
