graph TB
    subgraph Internet["Public Internet"]
        Users["Client / Browser"]
        GH_Actions["GitHub Actions CI/CD"]
    end

    subgraph AWS_Cloud["AWS Cloud (Region: us-east-1)"]
        subgraph VPC["Custom VPC (10.0.0.0/16)"]
            
            IGW["Internet Gateway (IGW)"]
            
            subgraph AZ1["Availability Zone 1 (us-east-1a)"]
                subgraph PubSubnet1["Public Subnet 1 (10.0.1.0/24)"]
                    ALB1["Application Load Balancer"]
                    NAT1["NAT Gateway 1 (EIP)"]
                end
                
                subgraph AppSubnet1["Private App Subnet 1 (10.0.11.0/24)"]
                    EC2_1["EC2 Instance (ASG Node 1)<br/>Node.js App :8080"]
                end
                
                subgraph DBSubnet1["Private DB Subnet 1 (10.0.21.0/24)"]
                    RDS_Primary[("RDS MySQL 8.0 Primary<br/>Port: 3306")]
                end
            end

            subgraph AZ2["Availability Zone 2 (us-east-1b)"]
                subgraph PubSubnet2["Public Subnet 2 (10.0.2.0/24)"]
                    ALB2["ALB Listener Node"]
                end
                
                subgraph AppSubnet2["Private App Subnet 2 (10.0.12.0/24)"]
                    EC2_2["EC2 Instance (ASG Node 2)<br/>Node.js App :8080"]
                end
                
                subgraph DBSubnet2["Private DB Subnet 2 (10.0.22.0/24)"]
                    RDS_Standby[("RDS MySQL Standby / Subnet Group")]
                end
            end
            
        end

        subgraph Managed_Services["AWS Managed Services"]
            ACM["AWS Certificate Manager (ACM)<br/>TLS 1.3 / HTTPS 443"]
            SecretsManager["AWS Secrets Manager<br/>DB Credentials (JSON)"]
            S3_Logs["S3 Bucket: ALB Access Logs<br/>AES-256 / Auto-Expiry"]
            S3_App["S3 Bucket: Application Storage<br/>AES-256 / Versioned"]
            SSM["AWS Systems Manager (SSM)<br/>Zero-SSH Session Manager"]
            OIDC["AWS IAM OIDC Provider<br/>token.actions.githubusercontent.com"]
        end
    end

    %% Flow Connections
    Users -->|HTTPS:443| IGW
    Users -.->|HTTP:80 301 Redirect| IGW
    IGW --> ALB1
    IGW --> ALB2
    ALB1 --- ACM
    ALB1 -->|Access Logs Delivery| S3_Logs
    
    ALB1 -->|HTTP:8080 Target Group| EC2_1
    ALB2 -->|HTTP:8080 Target Group| EC2_2
    
    EC2_1 -->|MySQL:3306 Private| RDS_Primary
    EC2_2 -->|MySQL:3306 Private| RDS_Primary
    RDS_Primary -.->|Replication| RDS_Standby
    
    EC2_1 -->|Outbound HTTPS via NAT| NAT1
    EC2_2 -->|Outbound HTTPS via NAT| NAT1
    NAT1 --> IGW
    
    EC2_1 -.->|Fetch DB Secret| SecretsManager
    EC2_2 -.->|Fetch DB Secret| SecretsManager
    EC2_1 -.->|Read / Write| S3_App
    EC2_2 -.->|Read / Write| S3_App
    EC2_1 -.->|Session Management| SSM
    
    GH_Actions -->|AssumeRoleWithWebIdentity| OIDC
    OIDC -->|Deploy IaC| VPC
